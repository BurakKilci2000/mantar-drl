# Ortam değişkenleri şablonu.
# Kullanmak için bu dosyanın bir kopyasını ".env" adıyla oluşturun ve değerleri düzenleyin.
# .env dosyası depoya eklenmez (.gitignore). Projede şu an parola ya da API anahtarı kullanılmamaktadır.

# Eğitimin çalışacağı cihaz: cuda (ekran kartı) ya da cpu
MANTAR_DEVICE=cuda

# Deney kayıtlarının yazılacağı klasör
MANTAR_RUNS_DIR=runs
